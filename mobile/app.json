{
  "expo": {
    "name": "FamilyKart AI",
    "slug": "familykart-ai",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "familykart",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow FamilyKart AI to use your microphone to add grocery items by voice.",
          "recordAudioAndroid": true
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
