ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=["*"]
DATABASE_URL=postgresql+psycopg://familykart:familykart@localhost:5432/familykart
REDIS_URL=redis://localhost:6379/0
REDIS_CHANNEL_PREFIX=familykart
REALTIME_RECONNECT_INITIAL_DELAY_SECONDS=0.5
REALTIME_RECONNECT_MAX_DELAY_SECONDS=30

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_MAX_OUTPUT_TOKENS=512
AI_MAX_INPUT_CHARACTERS=2000
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=FamilyKart AI
TRANSCRIPT_SIMULATION_ENABLED=false
AUDIO_UPLOAD_MAX_BYTES=5242880

JWT_SECRET_KEY=development-only-change-this-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ISSUER=familykart-api
JWT_AUDIENCE=familykart-mobile
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
HOUSEHOLD_INVITATION_EXPIRE_HOURS=24
